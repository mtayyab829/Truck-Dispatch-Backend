PORT=4100
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/truck_dispatch?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated allowed frontend origins (include your Vercel URL in production)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://truck-dispatch-lake.vercel.app
# true on Render/HTTPS so cookies work cross-site with the Vercel frontend
COOKIE_SECURE=false

# Gmail invoice email (works locally — NOT on Render free tier; SMTP ports are blocked)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Resend — recommended for Render free tier (HTTPS, not SMTP). Free: https://resend.com
# 1. Sign up, verify your sender email under Domains → add email
# 2. Create API key, paste below
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=TruckOps <your-gmail@gmail.com>

# Cloudinary document storage — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
